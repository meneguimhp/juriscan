APP_ENV=development
HTTP_ADDR=:8080
DB_PATH=juriscan.db
ALLOWED_ORIGINS=http://localhost:5174
LOGIN_TOKEN_ECHO=true
LEAD_SLA_MINUTES=30
WHATSAPP_PROVIDER=mock
WHATSAPP_WEBHOOK_TOKEN=
WHATSAPP_META_API_VERSION=v20.0
WHATSAPP_META_PHONE_NUMBER_ID=
WHATSAPP_META_ACCESS_TOKEN=
WHATSAPP_META_VERIFY_TOKEN=
AI_LOG_RETENTION_DAYS=90
PUBLICATION_RETENTION_DAYS=365

# Comma-separated email lists for initial bootstrap only.
# Authentication always validates against users persisted in DB.
ADMIN_EMAILS=admin@juriscan.local
CONTROLLER_EMAILS=leticia@juriscan.local
LAWYER_EMAILS=
COMMERCIAL_EMAILS=
